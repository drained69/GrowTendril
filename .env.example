# GrowTendril configuration. Keep all secrets server-side; never prefix them NEXT_PUBLIC_.

# Required for production
DATABASE_URL=
# Public origin, e.g. https://growtendril.xyz
APP_URL=
SESSION_SECRET=
ENCRYPTION_KEY=

# Circle developer-controlled wallets on Arc mainnet.
# Add these directly to Railway production variables. Do not paste them in chat.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Accounts, email and payments
# Email delivery (verification codes, welcome, billing notices, invites) through Resend.
RESEND_API_KEY=
# e.g. GrowTendril <hello@growtendril.xyz> (the domain must be verified in Resend)
EMAIL_FROM=
# Where alerts about USDC that reached the billing address without matching an invoice go (your own inbox).
OPERATOR_EMAIL=
# "Continue with Google". Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Prepaid credit: customers top up USDC on Arc to this address (a wallet you control), and each
# service takes its fixed price from their balance (prices live in src/lib/services.ts). Empty = everything free.
BILLING_ARC_ADDRESS=
# Development only: charge for services without a billing address ("Add credit" adds it for free).
# BILLING_DEV=1

# Optional network overrides
# ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
# GATEWAY_API_URL=https://gateway-api.circle.com
# CIRCLE_DISCOVERY_URL=https://api.circle.com/v2/x402/discovery/resources

# Optional public-source providers and language model.
# AI writing uses Gemini while GEMINI_API_KEY is set, otherwise Claude. LLM_PROVIDER=claude|gemini forces one.
# Free Gemini key: aistudio.google.com/apikey. GEMINI_MODEL takes a comma-separated fallback list.
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace (sk-ant-usr-…): the workspace ID from the Claude Console.
ANTHROPIC_WORKSPACE_ID=
GITHUB_TOKEN=
# X reads are pay-per-use; leave empty unless the X developer account has credits.
X_BEARER_TOKEN=
# Reddit works without keys (public search feed). Reddit approves new API apps by request.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:growtendril:0.1 (by /u/yourname)
YOUTUBE_API_KEY=
RSS_FEEDS=

# Optional onramp and external scheduler
ONRAMP_API_KEY=
CRON_SECRET=

# Optional standalone paid data service (npm run signals); not registered by default.
SIGNALS_SELLER_ADDRESS=
SIGNALS_API_PORT=4021

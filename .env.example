# ─────────────────────────────────────────────────────────────────────────────
# GrowTendril — environment. Everything is optional for the DEMO: with nothing set,
# the demo runs end to end and every payment is labelled SIMULATED.
# All secrets are server-side only. Never prefix them with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# Required in production (≥ 32 chars). In dev a random one is generated under .data/
SESSION_SECRET=

# Network: testnet (default) or mainnet. Mainnet moves real USDC — read README → Mainnet first.
# Mainnet needs a LIVE Circle API key (LIVE_API_KEY:…); testnet needs a TEST key (TEST_API_KEY:…).
# (The pre-rename name GROWTHOS_NETWORK is still read if GROWTENDRIL_NETWORK is unset.)
GROWTENDRIL_NETWORK=testnet
# Optional RPC override for the selected Arc network
# ARC_RPC_URL=

# Public base URL, used for invite links (e.g. https://growtendril.up.railway.app)
APP_URL=

# Encrypts workspace integration credentials at rest (AES-256-GCM). 32 bytes, hex or base64.
# Required in production; in dev one is generated under .data/encryption-key.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Database: leave empty for embedded Postgres (PGlite, stored in .data/pglite).
# DATABASE_URL=postgres://user:pass@localhost:5432/growtendril

# ── Background worker (autopilot cycles, settlement polling, Gateway deposits) ──
# Runs inside the web server by default. For multi-instance deployments set GROWTENDRIL_WORKER=off
# on web instances and run `npm run worker` as a separate process (Postgres required).
# GROWTENDRIL_WORKER=on
# WORKER_INTERVAL_MS=15000

# ── Agent wallet custody (pick ONE; wallets are created per workspace in the app) ──
# A) Circle developer-controlled wallets (recommended — keys stay in Circle custody).
#    Each workspace gets its own EOA on Arc (ARC-TESTNET or ARC, per network) from Wallet → Create agent wallet.
#    The API key must match the network: TEST_API_KEY:… on testnet, LIVE_API_KEY:… on mainnet.
#    npm run wallet:setup -- --entity-secret   (once, registers the entity secret)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# B) Server-side testnet key shared by workspaces (local development only). TESTNET ONLY.
#    npm run wallet:setup -- --local
AGENT_PRIVATE_KEY=

# ── x402 seller bundled in services/signals-api (port 4021) ─────────────────
# The Arc address (on the selected network) that receives payments for the bundled data service.
SIGNALS_SELLER_ADDRESS=
SIGNALS_API_URL=http://localhost:4021
# Optional: where demo creator payouts go (else SIGNALS_SELLER_ADDRESS, else a burn address).
DEMO_PAYOUT_ADDRESS=

# ── Circle endpoints (defaults shown) ───────────────────────────────────────
# GATEWAY_API_URL=https://gateway-api-testnet.circle.com   (mainnet: https://gateway-api.circle.com)
# CIRCLE_DISCOVERY_URL=https://api.circle.com/v2/x402/discovery/resources

# ── Optional: Arc Onramp ("Add budget") ─────────────────────────────────────
ONRAMP_API_KEY=

# ── Optional: Claude for product reading + creator drafts (heuristics otherwise)
ANTHROPIC_API_KEY=
# GROWTENDRIL_CLAUDE_MODEL=claude-opus-5-5

# ── Market data providers (official APIs only) ──────────────────────────────
# Platform defaults. Each workspace can store its own keys under Integrations (encrypted);
# workspace keys take precedence over these.
GITHUB_TOKEN=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:growtendril:0.1 (by /u/yourname)
YOUTUBE_API_KEY=
# Comma-separated RSS/Atom feeds for news & blogs
RSS_FEEDS=

# How many reverse proxies sit in front of the app (used to read the real client IP for rate limits). Default 1.
# TRUSTED_PROXY_HOPS=1

# ── External scheduler (serverless hosts): POST /api/cron/cycle with Authorization: Bearer …
# Runs due autopilot cycles and drains the job queue.
CRON_SECRET=
